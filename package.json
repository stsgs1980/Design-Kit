{
  "name": "design-kit",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "dev:up": "bash scripts/dev-up.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules --ignore .next --ignore .claude --ignore AGENTS.md",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:file-length": "node scripts/check-file-length.mjs --all",
    "check:docs": "node scripts/check-docs.mjs",
    "verify:code": "npm run lint && npm run typecheck && npm run check:file-length && npm run verify:merge",
    "verify:effects": "node scripts/verify-effects.mjs",
    "verify:all": "npm run verify:vendor && npm run verify:code && npm run verify:kit && npm run verify:patterns && npm run verify:props && npm run verify:claims && npm run verify:readme && npm run check:docs && npm run lint:md && npm run format:check && npm run verify:effects",
    "setup:hooks": "git init -q && husky",
    "changelog": "npx conventional-changelog -p angular -i CHANGELOG.md -s",
    "kit:registry": "node scripts/build-kit-registry.mjs",
    "verify:kit": "node scripts/verify-kit.mjs",
    "verify:patterns": "node scripts/verify-patterns.mjs",
    "verify:props": "node scripts/verify-props.mjs",
    "verify:vendor": "node scripts/verify-vendor.mjs",
    "shots": "node scripts/shots.mjs",
    "verify:merge": "node scripts/check-class-merge.mjs",
    "verify:links": "node scripts/verify-links.mjs",
    "verify:claims": "node scripts/verify-claims.mjs",
    "mutate": "node scripts/mutate.mjs",
    "mutate:live": "node scripts/mutate-live.mjs",
    "verify:readme": "node scripts/verify-readme.mjs"
  },
  "dependencies": {
    "framer-motion": "^14.6.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@eslint/markdown": "^8.0.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lint-staged": "^17.6.0",
    "markdownlint-cli": "^0.50.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=10.8.0"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,mts,cts,ts,tsx,json,md,css}": "prettier --write",
    "*.{js,jsx,mjs,cjs,mts,cts,ts,tsx}": "eslint --fix --max-warnings=0 --no-warn-ignored",
    "*.md": "markdownlint --fix --ignore node_modules"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
